+export type PaperOrderGuard = { expires_at_epoch_ms: number; intent_id: string; payload_sha256: string };
+
+export class PaperOrderNotSent extends Error {
+  constructor(public readonly code: "NH_SIGNAL_EXPIRED" | "NH_STOP_REQUESTED", public readonly guard: PaperOrderGuard) {
+    super(code);
+  }
+}
+
+function checkPaperOrderGuard(guard: PaperOrderGuard): void {
+  if (Date.now() >= guard.expires_at_epoch_ms) throw new PaperOrderNotSent("NH_SIGNAL_EXPIRED", guard);
+  const stopPath = process.env.NHPLUG_PAPER_ETF_STOP_PATH;
+  if (!stopPath || !isAbsolute(stopPath) || normalize(stopPath) !== stopPath || !stopPath.endsWith("/nhplug/shared-etf-paper/STOP")) {
+    throw new Error("ETF paper stop path unavailable");
+  }
+  if (!statSync(dirname(stopPath)).isDirectory()) throw new Error("ETF paper stop directory unavailable");
+  let stopped = false;
+  try {
+    lstatSync(stopPath);
+    stopped = true;
+  } catch (e) {
+    if ((e as NodeJS.ErrnoException).code !== "ENOENT") throw e;
+  }
+  if (stopped) throw new PaperOrderNotSent("NH_STOP_REQUESTED", guard);
+  if (!statSync(dirname(stopPath)).isDirectory()) throw new Error("ETF paper stop directory unavailable");
+  if (Date.now() >= guard.expires_at_epoch_ms) throw new PaperOrderNotSent("NH_SIGNAL_EXPIRED", guard);
+}
