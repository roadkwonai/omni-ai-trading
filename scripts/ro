#!/usr/bin/env bash
# Starts scripts/ro.py (the read-only runner; its rules are there) with this checkout's Python.
cd "$(dirname "$0")/.." || exit 1
for py in .venv/bin/python .venv/Scripts/python.exe; do
  [ -x "$py" ] && exec "$py" scripts/ro.py "$@"
done
echo "ro: no Python in .venv" >&2
exit 1
