+function cacheFile(config: Config): string {
+  const scope = createHash("sha256").update(config.authUrl + "\0" + config.appKey).digest("hex");
+  return join(homedir(), ".vibe-trading", "nhplug", "tokens", scope + ".json");
+}
+
+function store(file: string, token: TokenState): void {
+  const dir = join(homedir(), ".vibe-trading", "nhplug", "tokens");
+  mkdirSync(dir, { recursive: true, mode: 0o700 });
+  chmodSync(dir, 0o700);
+  const temp = file + "." + randomBytes(8).toString("hex") + ".tmp";
+  try {
+    writeFileSync(temp, JSON.stringify(token), { mode: 0o600, flag: "wx" });
+    renameSync(temp, file);
+  } finally { try { unlinkSync(temp); } catch {} }
+}
