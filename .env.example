# =============================================================================
#  vibe-trading 한국 확장(NH 나무증권 PLUG · Jev · KRX · OpenDART) 설정 예시
# =============================================================================
#
#  사용법
#    cp .env.example .env && chmod 600 .env
#    아래 값을 채운다. `.env`는 .gitignore에 들어 있으니 절대 커밋하지 않는다.
#
#  누가 이 파일을 읽나
#    - scripts/ 아래 실행기·대시보드가 `scripts/local_env.py`를 거쳐 읽는다.
#      `dotenv_values`로 "KEY=값" 줄만 파싱한다. 셸로 source하지 않으므로
#      $(...)·변수 치환·export 효과는 없다. `export KEY=값` 형식도 읽힌다.
#    - 값은 os.environ으로 내보내지 않는다. 각 스크립트가 필요한 키만 꺼내 쓴다.
#      그래서 증권사 키는 LLM 에이전트 프로세스나 그 하위 도구에 전달되지 않는다.
#    - NH MCP 실행기(scripts/nhplug_mcp.py)는 `--env-file`로 받은 파일에서
#      APP_KEY·APP_SECRET만 읽는다. ~/.vibe-trading/agent.json의 nhplug_* 서버가
#      이 파일을 가리키게 한다.
#
#  찾는 순서(scripts/local_env.py)
#    1) 셸/launchd 환경변수 VIBE_TRADING_ENV_FILE에 적은 경로
#    2) 저장소 루트의 .env  ← 기본
#    3) 저장소 상위 폴더의 .envrc  ← 예전 방식 호환용. 새로 쓰지 않는다.
#
#  이 파일과 따로 두는 설정
#    - LLM 에이전트(vibe-trading CLI·웹·MCP)의 공급자·모델 설정은
#      agent/.env.example을 참고해 ~/.vibe-trading/.env 또는 agent/.env에 둔다.
#      에이전트는 그중 먼저 찾은 파일 하나만 읽고, 이 루트 .env는 읽지 않는다.
#    - 에이전트 도구(krx_daily, opendart)는 KRX_API_KEY·OPENDART_API_KEY를
#      에이전트의 env 파일에서 읽는다. 에이전트로 KRX·공시 조회를 쓰려면
#      같은 두 값을 ~/.vibe-trading/.env에도 넣는다.
#    - 계좌별 운용금·한도·전략 수치는 env가 아니라 대시보드 "계좌·자동매매"
#      화면(~/.vibe-trading/nhplug/accounts.json, strategy-settings.json)에서 정한다.
#
#  보안
#    - 실계좌 번호·앱 키는 화면·로그·이슈·PR에 붙여 넣지 않는다.
#    - 키가 새어 나갔으면 NH PLUG·OpenAI·Jev 콘솔에서 바로 재발급한다.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. NH투자증권 나무 PLUG OpenAPI  (필수: 시세·잔고·주문)
# -----------------------------------------------------------------------------
#  발급: NH투자증권 PLUG 개발자 센터 → 앱 등록 → App Key / App Secret.
#  하나의 키로 운영 서버(api.nhplug.com, 시세·실계좌 조회)와
#  모의 서버(moapi.nhplug.com, 모의 주문)를 함께 쓴다. 토큰은 운영 인증 서버에서 발급된다.
#  읽는 곳: nhplug_mcp.py, nh_guarded_live.py, nh_live_follow.py, nh_ws_monitor.py
APP_KEY=
APP_SECRET=

#  실계좌 번호(숫자 11자리, 하이픈 없이 또는 하이픈 포함 모두 가능 — 숫자만 추려 쓴다).
#  읽는 곳: 실계좌 관찰·보호 주문 경로(nh_guarded_live, nh_live_auto, nh_live_follow,
#  nh_live_ai_observer, nh_live_loss_preflight, nh_live_position_watch).
#  실주문은 기본 꺼져 있고, 켜려면 별도 승인과 `--execute`가 필요하다.
#  실계좌를 쓰지 않으면 비워 둔다. 그러면 실계좌 경로는 계좌 확인 단계에서 오류로 멈춘다.
ACCOUNT_NUMBER=

#  추가 실계좌 번호(선택). 대시보드에 실계좌를 여러 개 등록하고 각 계좌를 미러 실행기로 실주문하려면 적습니다.
#  같은 APP_KEY/APP_SECRET에 연결된 계좌여야 합니다(NH PLUG 앱에 연결된 계좌). 실계좌 실행기
#  (nh_live_follow --execute)는 ACCOUNT_NUMBER, ACCOUNT_NUMBER_2, ACCOUNT_NUMBER_3 ... 에 적힌 계좌만 실주문을 허용합니다.
ACCOUNT_NUMBER_2=

#  모의계좌 번호(참고용). 현재 코드는 이 값을 직접 읽지 않는다.
#  모의 실행기는 ~/.vibe-trading/nhplug/isolated-paper/account.json에 고정한 계좌 해시와
#  agent.json nhplug_paper 서버의 --account 인자로 계좌를 정한다. 기록용으로만 남겨 둔다.
IMITATION_ACCOUNT_NUMBER=


# -----------------------------------------------------------------------------
#  2. AI 판단 엔진
# -----------------------------------------------------------------------------
#  OpenAI API 키. ETF 모의 실행기의 Decisions(빠른 판단)와 실계좌 AI 관찰기가 쓴다.
#  읽는 곳: nh_etf_paper_runner.py, nh_etf_auto_v2.py, nh_live_ai_observer.py
#  모델의 확률은 수익 확률이 아니다. 오류·판단 거부 시 실행기는 대기한다.
OPENAI_API_KEY=

#  TypeSafe Jev API 키. 분봉 차트 이미지와 뉴스로 종목 후보·보유 매도 의견을 받는다.
#  읽는 곳: nh_etf_auto_v2.py(→ nh_paper_isolated.py 실행기·Jev 보조 가상 실행기),
#  nh_jev_compare.py, nh_live_ai_observer.py
#  비워 두면 Jev 호출이 'JEV_API_KEY missing' 오류로 끝나 그 회차 Jev 의견이 없다.
JEV_API_KEY=


# -----------------------------------------------------------------------------
#  3. 공공 데이터 (선택)
# -----------------------------------------------------------------------------
#  KRX 정보데이터시스템 OpenAPI 키. 코스피·코스닥 일별 시세(krx_daily 도구).
#  발급: https://openapi.krx.co.kr → 서비스 이용 신청.
KRX_API_KEY=

#  금융감독원 OpenDART 키. 공시·재무제표(opendart 도구, kr_swing_v5_valuation.py).
#  발급: https://opendart.fss.or.kr → 인증키 신청.
OPENDART_API_KEY=

#  키움 REST API 앱 키(실전). 장중 프로그램매매 시간대별(scripts/kiwoom_data.py, 조회 TR 허용 목록만 호출).
#  발급: https://openapi.kiwoom.com → API 사용신청, 호출할 PC의 IP 등록. 없으면 해당 절만 빠진다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

#  토스증권 Open API(WTS 설정 > Open API, 허용 IP 등록 필요). 상장 예정 종목(scripts/toss_data.py, 조회 경로 허용 목록만).
#  클라이언트당 토큰이 1개라 모든 프로세스가 ~/.vibe-trading/toss/token.json을 같이 쓴다. 없으면 해당 절만 빠진다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  4. 장기투자 거시 자료 (선택)
# -----------------------------------------------------------------------------
#  미국 연준 FRED API 키(무료). 장기 엔진(scripts/longterm_macro.py)이 10년−2년 금리차·10년물·실질금리·
#  하이일드 스프레드와 30일 발표 일정(CPI·고용·GDP·PCE·PPI)을 읽어 리포트·시황 화면의 '거시 배경'에 쓴다.
#  국면 판정·주문 규칙은 이 값을 읽지 않는다. 없으면 그 입력만 빠진다.
#  발급: https://fred.stlouisfed.org → My Account → API Keys.
FRED_API_KEY=


# -----------------------------------------------------------------------------
#  5. 알림: Discord · Telegram · Slack (선택, scripts/discord_notify.py · launchd discord-notify)
# -----------------------------------------------------------------------------
#  알림은 채널 두 개로 나뉘고, 채널마다 아래 세 발송처 중 값이 있는 곳 모두로 같은 내용이 간다.
#  하나만 써도 되고 여럿을 같이 써도 된다. 비워 두면 그 발송처로는 보내지 않는다(기록은 그대로 남는다).
#    REALTIME: Jev 공유 모의·Jev 실계좌 체결(체결마다 즉시), 15:40 마감 요약, 장전 사전 점검 실패,
#              매매일지·장 마감 개선안·낙폭과대 주간 감사·장전 분석 리포트(HTML 링크)
#    LONGTERM: 장기 엔진 하루 판단·가상 주문·적립식·순자산, 장기투자 실계좌 체결·계획, 장기투자 리포트(HTML 링크)
#  한 방으로 받으려면 REALTIME과 LONGTERM에 같은 값을 넣는다.
#  웹훅 주소와 봇 토큰 자체가 비밀번호다. 화면·채팅·로그·커밋에 남기지 말고, 새어 나가면 바로 지우고 새로 만든다.
#  단계별 설정 방법과 문제 해결: docs/integrations.md (Discord · Telegram · Slack 절)
#  값을 넣거나 바꾼 뒤에는 확인하고 알림 서비스를 다시 시작한다(서비스는 시작할 때 .env를 읽는다):
#    PYTHONPATH=agent:scripts:streamlit_namuh .venv/bin/python scripts/discord_notify.py --test
#    launchctl kickstart -k gui/$(id -u)/com.vibetrading.discord-notify

#  Discord 웹훅. 채널 편집(톱니바퀴) → 연동 → 웹후크 → 새 웹후크 → 웹후크 URL 복사.
#  웹후크 관리 권한이 있는 서버여야 한다. 모양: https://discord.com/api/webhooks/<숫자>/<문자열>
#  새어 나가면: 같은 메뉴에서 그 웹후크를 삭제하고 새로 만든다.
DISCORD_WEBHOOK_REALTIME=
DISCORD_WEBHOOK_LONGTERM=

#  Telegram 봇 (2026-11-19). 봇 토큰과 채팅 ID가 모두 있어야 켜진다(토큰이 없으면 채팅 ID가 있어도 꺼짐).
#   1) @BotFather에 /newbot → 봇 이름과 'bot'으로 끝나는 사용자 이름을 정하면 토큰을 준다. 모양: 123456789:ABC...
#   2) 받을 곳 준비: 1:1은 봇에게 /start, 그룹은 봇 초대, 채널은 봇을 관리자로 추가.
#   3) 그곳에 메시지를 하나 보낸 뒤(그룹은 /start@봇사용자이름) 브라우저로
#      https://api.telegram.org/bot<토큰>/getUpdates 를 열어 "chat":{"id": ...} 숫자를 찾는다.
#      1:1은 양수, 그룹·채널은 보통 -100으로 시작한다. 이 주소에는 토큰이 들어 있으니 공유하지 않는다.
#   봇 하나로 두 방에 보낼 수 있다. 새어 나가면: @BotFather에 /revoke 로 토큰을 새로 받는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_REALTIME=
TELEGRAM_CHAT_LONGTERM=

#  Slack Incoming Webhook (2026-11-19).
#   1) https://api.slack.com/apps → Create New App → From scratch (앱 이름·워크스페이스 선택)
#   2) Incoming Webhooks 켜기 → Add New Webhook to Workspace → 채널 선택(채널 두 개면 두 번 추가)
#   모양: https://hooks.slack.com/services/T.../B.../...
#   워크스페이스에 따라 앱 설치에 관리자 승인이 필요하다. 새어 나가면: 그 웹후크를 Remove하고 새로 추가한다.
SLACK_WEBHOOK_REALTIME=
SLACK_WEBHOOK_LONGTERM=


# -----------------------------------------------------------------------------
#  6. GitHub Pages 리포트 발행 (선택, scripts/report_pages.py)
# -----------------------------------------------------------------------------
#  리포트(.md)를 HTML로 만들어 Pages 저장소에 푸시하고 Discord에는 제목·요약·링크를 보낸다.
#  HTML 생성은 설정이 없어도 로컬(~/.vibe-trading/report-pages/site)에서 늘 하고, 대시보드
#  API 연동 → 리포트 발행에서 미리보기·재생성·재게시·재발송한다.
#  주의: GitHub Pages 주소는 공개다. 검색 노출은 막지만(noindex·robots.txt) 링크를 아는 사람은 볼 수 있다.
#
#  Pages 저장소(owner/name). 이 저장소의 gh-pages 브랜치를 Pages 소스로 지정해 둔다.
REPORT_PAGES_REPO=
#  ↑ 예: <owner>/omni-ai-trading. 첫 푸시 때 저장소가 없으면 토큰 계정으로 공개 저장소를 만들고 Pages(gh-pages)를 켠다.
#  공개 주소. 비우면 https://<owner>.github.io/<name>/ 을 쓴다(사용자 도메인을 붙였으면 적는다).
REPORT_PAGES_URL=
#  Pages가 읽는 브랜치. 기본 gh-pages.
REPORT_PAGES_BRANCH=gh-pages
#  on일 때만 푸시한다. 그 전에는 로컬 커밋까지만 하고 리포트는 지금처럼 본문 텍스트로 Discord에 간다.
REPORT_PAGES_PUSH=off
#  푸시에 쓰는 GitHub 토큰(Pages 저장소 Contents 쓰기 권한). 이 파일에 없으면 저장소 상위 폴더 .envrc의
#  GH_TOKEN(또는 GITHUB_TOKEN)을 읽는다. 토큰은 git 명령줄이 아니라 환경변수로만 넘기고 기록하지 않는다.
GH_TOKEN=


# -----------------------------------------------------------------------------
#  7. 이 파일이 아니라 셸·launchd 환경에서 지정하는 변수 (참고)
# -----------------------------------------------------------------------------
#  아래 값은 .env에 적어도 스크립트가 읽지 않는다. 필요하면 셸에서 export하거나
#  launchd plist의 EnvironmentVariables에 넣는다(scripts/launchd_services.py).
#
#  VIBE_TRADING_ENV_FILE=/절대/경로/.env   이 파일 대신 다른 env 파일을 쓸 때
#  VIBE_TRADING_HOME=~/.vibe-trading       런타임 데이터 폴더(원장·이벤트·설정). 기본값 그대로 권장
#  PYTHONPATH=agent:scripts                스크립트 실행 시 필요(launchd 정의에 이미 들어 있음)
